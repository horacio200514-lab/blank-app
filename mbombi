import streamlit as st
import math

# -------------------------------------------------
# EQUAÇÃO
# log10(Psat/mmHg) =
# 23.686185 - 1691.8057/T - 6.04560*log10(T)
# + 0.00195754*T
# -------------------------------------------------

def pressao_saturacao(T):
    return 10 ** (
        23.686185
        - 1691.8057 / T
        - 6.04560 * math.log10(T)
        + 0.00195754 * T
    )


def converter_para_mmhg(pressao, unidade):
    if unidade == "mmHg":
        return pressao
    elif unidade == "kPa":
        return pressao * 7.50061683
    elif unidade == "bar":
        return pressao * 750.061683
    elif unidade == "atm":
        return pressao * 760.0


def encontrar_temperatura(pressao_mmhg):
    """
    Resolve numericamente a equação usando o método da bisseção.
    """

    limite_inferior = 100.0
    limite_superior = 2000.0

    f_inferior = pressao_saturacao(limite_inferior) - pressao_mmhg
    f_superior = pressao_saturacao(limite_superior) - pressao_mmhg

    if f_inferior * f_superior > 0:
        return None

    for _ in range(200):
        meio = (limite_inferior + limite_superior) / 2
        f_meio = pressao_saturacao(meio) - pressao_mmhg

        if abs(f_meio) < 1e-8:
            return meio

        if f_inferior * f_meio < 0:
            limite_superior = meio
            f_superior = f_meio
        else:
            limite_inferior = meio
            f_inferior = f_meio

    return (limite_inferior + limite_superior) / 2


# -------------------------------------------------
# CONFIGURAÇÃO DA PÁGINA
# -------------------------------------------------

st.set_page_config(
    page_title="Calculadora de Temperatura de Saturação",
    page_icon="🌡️",
    layout="centered"
)

st.title("🌡️ Calculadora de Temperatura de Saturação")

st.write(
    "Digite a pressão de saturação e a calculadora "
    "determinará a temperatura correspondente."
)

st.latex(
    r"""
    \log_{10}\left(\frac{p^{sat}}{\mathrm{mmHg}}\right)
    =
    23.686185
    -
    \frac{1691.8057}{T}
    -
    6.04560\log_{10}(T)
    +
    0.00195754T
    """
)

st.info("A temperatura T é considerada em Kelvin.")

# -------------------------------------------------
# ENTRADA
# -------------------------------------------------

pressao = st.number_input(
    "Pressão de saturação:",
    min_value=0.000001,
    value=760.0,
    step=1.0
)

unidade = st.selectbox(
    "Unidade da pressão:",
    ["mmHg", "kPa", "bar", "atm"]
)

# -------------------------------------------------
# CÁLCULO
# -------------------------------------------------

if st.button("🔢 Calcular temperatura", type="primary"):

    pressao_mmhg = converter_para_mmhg(pressao, unidade)

    temperatura = encontrar_temperatura(pressao_mmhg)

    if temperatura is None:

        st.error(
            "Não foi possível encontrar uma solução "
            "no intervalo de 100 K a 2000 K."
        )

    else:

        temperatura_celsius = temperatura - 273.15

        st.success("Cálculo realizado!")

        col1, col2 = st.columns(2)

        with col1:
            st.metric(
                "Temperatura (K)",
                f"{temperatura:.4f} K"
            )

        with col2:
            st.metric(
                "Temperatura (°C)",
                f"{temperatura_celsius:.4f} °C"
            )

        st.write(
            f"**Pressão utilizada:** "
            f"{pressao:.6g} {unidade}"
        )

        st.write(
            f"**Pressão convertida:** "
            f"{pressao_mmhg:.6f} mmHg"
        )

        st.write(
            f"**log₁₀(P):** "
            f"{math.log10(pressao_mmhg):.8f}"
        )

        # Verificação
        pressao_verificada = pressao_saturacao(temperatura)

        st.write(
            f"**Verificação:** "
            f"{pressao_verificada:.6f} mmHg"
        )


# -------------------------------------------------
# HISTÓRICO
# -------------------------------------------------

if "historico" not in st.session_state:
    st.session_state.historico = []

if st.button("➕ Adicionar cálculo ao histórico"):

    pressao_mmhg = converter_para_mmhg(pressao, unidade)
    temperatura = encontrar_temperatura(pressao_mmhg)

    if temperatura is not None:

        st.session_state.historico.append({
            "Pressão": pressao,
            "Unidade": unidade,
            "T (K)": round(temperatura, 4),
            "T (°C)": round(temperatura - 273.15, 4)
        })

        st.success("Cálculo adicionado ao histórico.")

if st.session_state.historico:

    st.subheader("📋 Histórico de cálculos")

    st.dataframe(
        st.session_state.historico,
        use_container_width=True
    )

    if st.button("🗑️ Apagar histórico"):
        st.session_state.historico = []
        st.rerun()